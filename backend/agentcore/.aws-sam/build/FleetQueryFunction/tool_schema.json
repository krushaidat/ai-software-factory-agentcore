{
  "tool_name": "fleet_query",
  "description": "Lists test environments (VEW / HIL / SIL / Fleet vehicles) that match a capability, ASIL, status and queue-depth filter. Reads from the ai-software-factory-fleet-prod DynamoDB inventory and falls back to a hard-coded mirror of the UI seed data.",
  "input_schema": {
    "type": "object",
    "properties": {
      "filter": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["VEW", "HIL", "SIL", "Fleet"]},
          "available": {"type": "boolean"},
          "asil_capable": {"type": "string", "enum": ["QM", "A", "B", "C", "D"], "description": "Minimum ASIL level the environment must satisfy."},
          "capability": {
            "oneOf": [
              {"type": "string"},
              {"type": "array", "items": {"type": "string"}}
            ],
            "description": "Required capability or capabilities (matched case-insensitively against the environment's capability list)."
          },
          "fw_version": {"type": "string"},
          "location": {"type": "string"},
          "max_queue_depth": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      },
      "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 25}
    }
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "environments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "type": {"type": "string"},
            "status": {"type": "string"},
            "capabilities": {"type": "array", "items": {"type": "string"}},
            "hw_revision": {"type": "string"},
            "fw_version": {"type": "string"},
            "queue_depth": {"type": "integer"},
            "asil_capable": {"type": "string"},
            "location": {"type": "string"},
            "last_heartbeat": {"type": "string"}
          },
          "required": ["id", "type", "status", "asil_capable"]
        }
      },
      "total_in_inventory": {"type": "integer"},
      "matched_count": {"type": "integer"},
      "filter_applied": {"type": "object"},
      "source": {"type": "string", "enum": ["dynamodb", "fallback"]},
      "fallback_reason": {"type": ["string", "null"]},
      "latency_ms": {
        "type": "object",
        "properties": {
          "dynamodb": {"type": "integer"},
          "total": {"type": "integer"}
        }
      }
    },
    "required": ["environments", "matched_count", "source"]
  }
}
